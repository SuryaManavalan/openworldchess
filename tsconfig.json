{
  "compilerOptions": {
    "target": "ES2023",
    "module": "NodeNext",
    "moduleResolution": "NodeNext",
    "lib": ["ES2023", "DOM", "DOM.Iterable"],
    "strict": true,
    "noEmit": true,
    "allowImportingTsExtensions": true,
    "verbatimModuleSyntax": true,
    "erasableSyntaxOnly": true,
    "skipLibCheck": true,
    "jsx": "react-jsx",
    "types": ["node"],
    "allowJs": true,
    "checkJs": false
  },
  "include": ["packages/*/src", "packages/*/sim", "packages/*/test", "apps/server/src", "apps/bots/src", "apps/client/src"]
}
