[Unit]
Description=Open World Chess game server
After=network-online.target

[Service]
User=owc
WorkingDirectory=/opt/owc/app
Environment=NODE_ENV=production PORT=80 DATA=/var/lib/owc/world.json PUBLIC_URL=https://openworldchess.com
# Secrets and Google OAuth: GOOGLE_CLIENT_ID, GOOGLE_CLIENT_SECRET, ORIGIN_SECRET
EnvironmentFile=-/etc/owc/env
ExecStart=/usr/bin/node apps/server/src/main.ts
AmbientCapabilities=CAP_NET_BIND_SERVICE
Restart=always
RestartSec=2
KillSignal=SIGTERM
TimeoutStopSec=10

[Install]
WantedBy=multi-user.target
